{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["bun", "node"]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "packages/core/tests/**/*.ts",
    "packages/cli/tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "dist",
    "**/dist/**",
    "coverage",
    "**/coverage/**"
  ]
}
