{
  "name": "kepler",
  "version": "0.10.3",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:core && bun run build:cli",
    "build:core": "bun run --filter @vialactea-works/kepler-core build",
    "build:cli": "bun run --filter @vialactea-works/kepler-cli build",
    "typecheck": "bun run tsc --project tsconfig.tests.json",
    "test:unit": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration --no-file-parallelism",
    "test:package": "bun --bun vitest run --project integration packages/core/tests/integration/packed-package.test.ts",
    "test:e2e": "bun run build && bun --bun vitest run --project e2e",
    "test": "bun run check:typescript-sources && bun run typecheck && bun run test:unit && bun run test:integration && bun run test:e2e",
    "check:version": "bun scripts/check-versions.ts",
    "check:typescript-sources": "bun scripts/check-typescript-sources.ts",
    "test:file": "bun --bun vitest run --reporter=verbose",
    "test:agent": "bun --bun vitest run 2>&1 | tail -8",
    "install-local": "bun run build && mkdir -p ~/.local/bin && ln -sf $(pwd)/packages/cli/dist/cli/main.js ~/.local/bin/kepler && chmod +x packages/cli/dist/cli/main.js",
    "purge": "rm -f ~/.local/bin/kepler; rm -rf ~/.kepler-dist/"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/testing": "12.1.0",
    "@types/bun": "1.3.14",
    "@types/inquirer": "8.2.13",
    "@types/node": "22.16.0",
    "ajv": "8.17.1",
    "execa": "9.6.1",
    "marked": "15.0.12",
    "nest-commander": "3.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vitest": "4.1.8",
    "yaml": "2.4.5"
  }
}
